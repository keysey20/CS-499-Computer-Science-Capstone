
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Computer Science Capstone ePortfolio showcasing software engineering, algorithms, data structures, and database development.">
  <title>Computer Science ePortfolio | Reynaldo Williams</title>

  <style>
    :root {
      --navy: #0b1220;
      --surface: #142238;
      --blue: #60a5fa;
      --white: #f8fafc;
      --muted: #cbd5e1;
      --border: #334155;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--navy);
      color: var(--white);
      line-height: 1.7;
    }

    a {
      color: var(--blue);
    }

    header {
      padding: 72px 20px;
      text-align: center;
      background: linear-gradient(135deg, #10213c, #0b1220);
      border-bottom: 1px solid var(--border);
    }

    header h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      margin: 0;
    }

    header p {
      color: var(--muted);
      font-size: 1.15rem;
    }

    .subtitle {
      color: var(--blue);
      font-weight: bold;
      letter-spacing: 1px;
    }

    nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px 24px;
      padding: 18px;
      background: #101c30;
      border-bottom: 1px solid var(--border);
    }

    nav a {
      text-decoration: none;
      color: var(--white);
      font-weight: bold;
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--blue);
      text-decoration: underline;
    }

    main {
      width: min(1100px, 92%);
      margin: 40px auto;
    }

    section {
      margin-bottom: 48px;
      scroll-margin-top: 25px;
    }

    h2 {
      color: var(--blue);
      margin-bottom: 14px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 28px;
      margin-top: 18px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
      gap: 20px;
    }

    .card h3 {
      margin-top: 0;
      color: var(--white);
    }

    .card p,
    section p {
      color: var(--muted);
    }

    .button {
      display: inline-block;
      padding: 10px 18px;
      margin-top: 10px;
      background: var(--blue);
      color: #081321;
      font-weight: bold;
      text-decoration: none;
      border-radius: 8px;
    }

    .button:hover,
    .button:focus-visible {
      background: #93c5fd;
    }

    .status {
      display: inline-block;
      color: #fcd34d;
      font-size: 0.9rem;
      font-weight: bold;
    }

    footer {
      text-align: center;
      padding: 28px;
      border-top: 1px solid var(--border);
      color: var(--muted);
    }

    @media (max-width: 600px) {
      header {
        padding: 48px 18px;
      }

      .card {
        padding: 20px;
      }

      nav {
        gap: 12px 18px;
      }
    }
  </style>
</head>

<body>

  <header>
    <p class="subtitle">COMPUTER SCIENCE CAPSTONE</p>
    <h1>Reynaldo Williams</h1>
    <p>Software Development | Data & Algorithms | Cybersecurity</p>
    <p>Southern New Hampshire University | CS-499 ePortfolio</p>
    <a class="button" href="https://github.com/keysey20">
      View My GitHub
    </a>
  </header>

  <nav aria-label="Main navigation">
    <a href="#about">About</a>
    <a href="#assessment">Self-Assessment</a>
    <a href="#review">Code Review</a>
    <a href="#enhancements">Enhancements</a>
    <a href="#contact">Contact</a>
  </nav>

