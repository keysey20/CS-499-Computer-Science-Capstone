    </section>

    <section id="contact">
      <h2>Professional Portfolio</h2>
      <div class="card">
        <p>
          Explore my public GitHub repositories to review
          additional projects in software development,
          artificial intelligence, testing, and computer science.
        </p>
        <a class="button" href="https://github.com/keysey20">
          Explore GitHub Projects
        </a>
      </div>
    </section>

  </main>

  <footer>
    <p>Reynaldo Williams | CS-499 Computer Science Capstone</p>
    <p>Southern New Hampshire University</p>
  </footer>

</body>
</html>

